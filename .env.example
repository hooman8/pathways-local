# Optional. You can also save your key in the app's AI settings.
# Never commit your real .env file or any API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=128000
PATHWAYS_OPENAI_ENABLED=true
# Docker Compose publishes only to localhost; change this if 8080 is busy.
PATHWAYS_PORT=8080
# Optional for npm run dev; Compose supplies its own values for these.
# Leave APP_BASE_URL unset when using Docker so Compose's origin is authoritative.
# APP_BASE_URL=http://localhost:5173
# PATHWAYS_DB_PATH=./data/pathways.sqlite
NEXT_TELEMETRY_DISABLED=1
